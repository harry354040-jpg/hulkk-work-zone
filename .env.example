# GEMINI_API_KEY: Used for Google Gemini AI models.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional if you prefer to use OpenAI directly for the AI Fitness Coach.
# If provided, the backend supports OpenAI chat completions (e.g. gpt-4o-mini).
OPENAI_API_KEY="your_openai_api_key_here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Server port (3000)
PORT=3000
